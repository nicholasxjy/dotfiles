#
#
#
# 不生成假的 Bold / Italic。
# 优先使用字体自身提供的真实字重和斜体。
font-synthetic-style = false
# 关闭额外增粗，避免斜体细笔画的边缘显得发糊。
font-thicken = false
# font-thicken-strength = 55
# Ghostty macOS 默认是 native。
#
# linear-corrected：
# - 保留接近 native 的字体重量
# - 避免某些前景/背景颜色组合下 glyph 边缘发黑
# - 特别适合 Neovim syntax highlighting
alpha-blending = native

# 光标覆盖 ligature 时重新拆分 shaping，
# 编辑代码时能看到真实字符。
font-shaping-break = cursor

adjust-underline-thickness = -50%
adjust-box-thickness = -51%
adjust-cursor-height = -10%
# adjust-cell-height = 2%
# adjust-cell-width = 2%

# window-padding-x = 8
# window-padding-y = 8

macos-window-shadow = true
macos-titlebar-style = tabs
macos-option-as-alt = true

# cursor-style = bar
cursor-style-blink = true

# background-opacity = 0.9
# background-blur-radius = 50
# background-blur=macos-glass-regular

link-url = true
copy-on-select = true

auto-update = check
auto-update-channel = tip

mouse-hide-while-typing = true

keybind = super+i=inspector:toggle
keybind = super+r=reload_config

