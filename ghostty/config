# vim: set ft=conf :
# theme = hojicha
# theme = moon
# theme = gyokuro
# theme = github dark
# theme = tokyonight night
# theme = gruvbox material dark
# theme = everforest dark med
theme = catppuccin mocha


# shell-integration-features =ssh-env,no-cursor,sudo,title


font-size = 20.5
font-family = Operator Mono SSm Lig
font-family = Maple Mono NF CN
font-feature = ss11
font-feature = ss12

# font-codepoint-map=U+2E80-U+2EFF,U+2F00-U+2FDF,U+3000-U+303F,U+31C0-U+31EF,U+3400-U+4DBF,U+4E00-U+9FFF,U+F900-U+FAFF,U+FE30-U+FE4F,U+FF00-U+FFEF,U+20000-U+2A6DF,U+2A700-U+2B73F,U+2B740-U+2B81F,U+2B820-U+2CEAF,U+2CEB0-U+2EBEF,U+2EBF0-U+2EE5F,U+30000-U+3134F,U+31350-U+323AF=Maple Mono NF CN

# font-size = 21
# font-family = JetbrainsMono Nerd Font
# font-feature = calt
# font-feature = liga
# font-feature = dlig

font-thicken = false

adjust-box-thickness = -50%
adjust-cursor-height = -10%
adjust-cell-height = 4%
# adjust-cell-width = 1%

# window-padding-x = 8
# window-padding-y = 8

macos-window-shadow = true
macos-titlebar-style = hidden
macos-option-as-alt = true

cursor-color=#00E0BA
# cursor-style = bar
cursor-style-blink = true
# cursor-opacity = 0.8

# background-opacity = 0.96
# background-blur-radius = 40
# background-blur=macos-glass-regular

link-url = true
copy-on-select = true

auto-update = check
auto-update-channel = tip

mouse-hide-while-typing = true

keybind = super+i=inspector:toggle
keybind = super+r=reload_config

# custom-shader = ./shaders/blaze_sparks.glsl
custom-shader = ./shaders/ripple_cursor.glsl
# custom-shader = ./shaders/cursor_warp.glsl
custom-shader = ./shaders/cursor_synesthaxia.glsl
