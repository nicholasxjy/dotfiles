# randomhue light orange — Ghostty port of mini.hues
# Source: https://github.com/nvim-mini/mini.hues/blob/ea046f08a2759050eaa8004cf9faa5eb599e56c5/colors/randomhue.lua
# Upstream revision: ea046f08a2759050eaa8004cf9faa5eb599e56c5
# Extracted from the upstream light colorscheme in Neovim.
# randomhue is dynamic upstream; this is a static OKLch hue 45 snapshot.
# Generated with gen_random_base_colors(gen_hue=45), saturation=high.
# Representative hue variant; not sampled from the README screenshot.

background = #e9e1dd
foreground = #332d2a
cursor-color = #332d2a
cursor-text = #e9e1dd

# Visual selection: preserve each cell foreground, as in upstream Visual.
selection-background = #a8a19d
selection-foreground = cell-foreground

# Search and CurSearch highlights.
search-foreground = #e9e1dd
search-background = #7d3500
search-selected-foreground = #e9e1dd
search-selected-background = #805100

# Exact upstream terminal_color_0 through terminal_color_15.
# Upstream intentionally shares normal and bright chromatic colors.
palette = 0=#110c09
palette = 1=#63004c
palette = 2=#5f6900
palette = 3=#805100
palette = 4=#017d89
palette = 5=#3a0473
palette = 6=#00714a
palette = 7=#a8a19d
palette = 8=#6c6562
palette = 9=#63004c
palette = 10=#5f6900
palette = 11=#805100
palette = 12=#017d89
palette = 13=#3a0473
palette = 14=#00714a
