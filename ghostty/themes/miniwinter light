# miniwinter light — Ghostty port of mini.hues
# Source: https://github.com/nvim-mini/mini.hues/blob/ea046f08a2759050eaa8004cf9faa5eb599e56c5/colors/miniwinter.lua
# Upstream revision: ea046f08a2759050eaa8004cf9faa5eb599e56c5
# Extracted from the upstream light colorscheme in Neovim.

background = #dce4e8
foreground = #312e29
cursor-color = #312e29
cursor-text = #dce4e8

# Visual selection: preserve each cell foreground, as in upstream Visual.
selection-background = #9ca4a7
selection-foreground = cell-foreground

# Search and CurSearch highlights.
search-foreground = #dce4e8
search-background = #014772
search-selected-foreground = #dce4e8
search-selected-background = #565600

# Exact upstream terminal_color_0 through terminal_color_15.
# Upstream intentionally shares normal and bright chromatic colors.
palette = 0=#0f0d09
palette = 1=#5c0113
palette = 2=#00562e
palette = 3=#565600
palette = 4=#014772
palette = 5=#4f0b46
