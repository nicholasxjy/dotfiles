# randomhue light azure — Ghostty port of mini.hues
# Source: https://github.com/nvim-mini/mini.hues/blob/ea046f08a2759050eaa8004cf9faa5eb599e56c5/colors/randomhue.lua
# Upstream revision: ea046f08a2759050eaa8004cf9faa5eb599e56c5
# Extracted from the upstream light colorscheme in Neovim.
# randomhue is dynamic upstream; this is a static OKLch hue 225 snapshot.
# Generated with gen_random_base_colors(gen_hue=225), saturation=high.
# Representative hue variant; not sampled from the README screenshot.

background = #dce4e8
foreground = #292f32
cursor-color = #292f32
cursor-text = #dce4e8

# Visual selection: preserve each cell foreground, as in upstream Visual.
selection-background = #9ca3a7
selection-foreground = cell-foreground

# Search and CurSearch highlights.
search-foreground = #dce4e8
search-background = #00698b
search-selected-foreground = #dce4e8
search-selected-background = #805100

# Exact upstream terminal_color_0 through terminal_color_15.
# Upstream intentionally shares normal and bright chromatic colors.
palette = 0=#090e11
palette = 1=#63004c
palette = 2=#5d6800
palette = 3=#805100
palette = 4=#007c88
palette = 5=#3a0372
palette = 6=#00724c
palette = 7=#9ca3a7
palette = 8=#61686b
palette = 9=#63004c
palette = 10=#5d6800
palette = 11=#805100
palette = 12=#007c88
palette = 13=#3a0372
palette = 14=#00724c
palette = 15=#eff7fb

