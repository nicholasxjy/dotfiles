# minispring light — Ghostty port of mini.hues
# Source: https://github.com/nvim-mini/mini.hues/blob/ea046f08a2759050eaa8004cf9faa5eb599e56c5/colors/minispring.lua
# Upstream revision: ea046f08a2759050eaa8004cf9faa5eb599e56c5
# Extracted from the upstream light colorscheme in Neovim.

background = #e0e4de
foreground = #2c2e33
cursor-color = #2c2e33
cursor-text = #e0e4de

# Visual selection: preserve each cell foreground, as in upstream Visual.
selection-background = #a0a39e
selection-foreground = cell-foreground

# Search and CurSearch highlights.
search-foreground = #e0e4de
search-background = #2e5e00
search-selected-foreground = #e0e4de
search-selected-background = #676900

# Exact upstream terminal_color_0 through terminal_color_15.
# Upstream intentionally shares normal and bright chromatic colors.
palette = 0=#0b0d11
palette = 1=#700015
